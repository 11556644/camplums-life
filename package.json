  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "start": "node scripts/start.js",
    "lint": "eslint",
