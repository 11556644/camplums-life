    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.16.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.76.0",
